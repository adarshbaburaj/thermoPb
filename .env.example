# The implemented app is a local demo. Setting this to 0 does not enable providers.
DEMO_MODE=1

# Next.js server-side proxy destination.
API_URL=http://127.0.0.1:8000

# Optional absolute path to a separate persistent SQLite demo workspace.
# Default: <repository>/api/data/thermopb.sqlite3
# THERMOPB_DB_PATH=/tmp/thermopb-demo.sqlite3

# AI provider configuration reserved for the live integration.
# Choose anthropic (Claude) or openai. Claude is the current preference.
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Optional model overrides; leave blank until the live adapter is configured.
ANTHROPIC_MODEL=
OPENAI_MODEL=

# The current demo does not call either provider; adding keys does not enable one.
# Never commit credentials or put private keys in NEXT_PUBLIC_ variables.
